{
  "name": "@open-everywhere/provider-google-chat",
  "version": "0.7.0",
  "description": "Open Everywhere Google Chat provider — the agent as a Google Chat app: mention and DM wakes, threaded replies.",
  "keywords": [
    "agent",
    "google-chat",
    "google-workspace",
    "chat",
    "eve"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/open-everywhere/open-everywhere/tree/main/packages/providers/google-chat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-everywhere/open-everywhere.git",
    "directory": "packages/providers/google-chat"
  },
  "bugs": {
    "url": "https://github.com/open-everywhere/open-everywhere/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "agent",
    "dist",
    "tsconfig.json",
    "tsconfig.build.json",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./agent/channels/google-chat-auth.js": {
      "types": "./dist/agent/channels/google-chat-auth.d.ts",
      "default": "./dist/agent/channels/google-chat-auth.js"
    },
    "./agent/channels/google-chat-front.js": {
      "types": "./dist/agent/channels/google-chat-front.d.ts",
      "default": "./dist/agent/channels/google-chat-front.js"
    },
    "./agent/channels/google-chat-identity.js": {
      "types": "./dist/agent/channels/google-chat-identity.d.ts",
      "default": "./dist/agent/channels/google-chat-identity.js"
    },
    "./agent/channels/google-chat-message-ops.js": {
      "types": "./dist/agent/channels/google-chat-message-ops.d.ts",
      "default": "./dist/agent/channels/google-chat-message-ops.js"
    },
    "./agent/channels/google-chat-origin-codec.js": {
      "types": "./dist/agent/channels/google-chat-origin-codec.d.ts",
      "default": "./dist/agent/channels/google-chat-origin-codec.js"
    },
    "./agent/channels/google-chat-post-arm.js": {
      "types": "./dist/agent/channels/google-chat-post-arm.d.ts",
      "default": "./dist/agent/channels/google-chat-post-arm.js"
    },
    "./agent/channels/google-chat-rest.js": {
      "types": "./dist/agent/channels/google-chat-rest.d.ts",
      "default": "./dist/agent/channels/google-chat-rest.js"
    },
    "./agent/channels/google-chat.js": {
      "types": "./dist/agent/channels/google-chat.d.ts",
      "default": "./dist/agent/channels/google-chat.js"
    },
    "./agent/contributions.js": {
      "types": "./dist/agent/contributions.d.ts",
      "default": "./dist/agent/contributions.js"
    },
    "./agent/docs-generated.js": {
      "types": "./dist/agent/docs-generated.d.ts",
      "default": "./dist/agent/docs-generated.js"
    },
    "./agent/policy.js": {
      "types": "./dist/agent/policy.d.ts",
      "default": "./dist/agent/policy.js"
    },
    "./agent/provider-events.js": {
      "types": "./dist/agent/provider-events.d.ts",
      "default": "./dist/agent/provider-events.js"
    },
    "./agent/register.js": {
      "types": "./dist/agent/register.d.ts",
      "default": "./dist/agent/register.js"
    },
    "./agent/surface-parity.js": {
      "types": "./dist/agent/surface-parity.d.ts",
      "default": "./dist/agent/surface-parity.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:chain",
    "test:chain": "tsx ../../../scripts/chain/run-chain.ts",
    "test:google-chat-auth": "NODE_NO_WARNINGS=1 tsx scripts/google-chat-auth-test.ts",
    "test:google-chat-front": "NODE_NO_WARNINGS=1 tsx scripts/google-chat-front-test.ts",
    "test:google-chat-post-arm": "NODE_NO_WARNINGS=1 tsx scripts/google-chat-post-arm-test.ts"
  },
  "dependencies": {
    "@open-everywhere/core": "0.7.0",
    "jose": "6.2.3"
  },
  "peerDependencies": {
    "eve": "0.71.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
