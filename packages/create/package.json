{
  "name": "@open-everywhere/create",
  "version": "0.7.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "npx scaffold and setup check for Open Everywhere — one step engine, reported by --check for an agent-led setup.",
  "keywords": [
    "agent",
    "cli",
    "installer",
    "scaffold",
    "slack",
    "self-hosted",
    "create"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-everywhere/open-everywhere.git",
    "directory": "packages/create"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "create-open-everywhere": "./bin/create-open-everywhere.js"
  },
  "files": [
    "bin",
    "src",
    "template",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cli": "tsx src/cli.ts",
    "test:engine": "tsx scripts/engine-test.ts",
    "test:cli": "tsx scripts/cli-check-test.ts",
    "test": "npm run test:chain",
    "test:chain": "tsx ../../scripts/chain/run-chain.ts",
    "test:boot-free": "tsx scripts/boot-free-test.ts",
    "test:scaffold": "tsx scripts/scaffold-test.ts",
    "test:env-pipe": "tsx scripts/env-pipe-test.ts"
  },
  "dependencies": {
    "@open-everywhere/core": "0.7.0",
    "@open-everywhere/provider-slack": "0.7.0",
    "tsx": "^4.23.9"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}
