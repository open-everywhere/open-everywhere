{
  "name": "{{APP_NAME}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "oe-eve-patch",
    "oe:build": "oe build",
    "predev": "oe build",
    "dev": "EVE_TELEMETRY_DISABLED=1 eve dev",
    "prebuild": "oe build",
    "build": "EVE_TELEMETRY_DISABLED=1 eve build",
    "prestart": "oe build",
    "start": "EVE_TELEMETRY_DISABLED=1 eve start",
    "pretypecheck": "oe build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "create-open-everywhere --check",
    "check:model-config": "node --import tsx scripts/model-config-check.ts",
    "ops": "node --import tsx scripts/ops-mcp.ts",
    "env:pipe": "node scripts/env-pipe.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@open-everywhere/adapters": "{{OE_VERSION}}",
    "@open-everywhere/core": "{{OE_VERSION}}",
    "@open-everywhere/provider-discord": "{{OE_VERSION}}",
    "@open-everywhere/provider-email": "{{OE_VERSION}}",
    "@open-everywhere/provider-github": "{{OE_VERSION}}",
    "@open-everywhere/provider-google-chat": "{{OE_VERSION}}",
    "@open-everywhere/provider-linear": "{{OE_VERSION}}",
    "@open-everywhere/provider-notion": "{{OE_VERSION}}",
    "@open-everywhere/provider-slack": "{{OE_VERSION}}",
    "@open-everywhere/provider-teams": "{{OE_VERSION}}",
    "eve": "1.0.0-rc.18",
    "just-bash": "^3.1.0"
  },
  "devDependencies": {
    "@open-everywhere/create": "{{OE_VERSION}}",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "zod": "4.5.4",
    "@agent-browser/eve": {
      "zod": "4.5.4",
      "eve": "$eve"
    },
    "eve": {
      "undici": "8.11.2",
      "@ai-sdk/provider-utils": {
        "undici": "7.30.0"
      }
    },
    "guarded-fetch": {
      "undici": "7.30.0"
    },
    "just-bash": {
      "typescript": "$typescript"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "@mongodb-js/zstd": true
  }
}
