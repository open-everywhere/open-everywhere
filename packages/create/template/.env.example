# Copy to .env.local (it is gitignored) and fill in. eve loads .env and .env.local.
#
# Variable NAMES only. Never commit a value. On Vercel, set each one with `vercel env add <NAME>`.
# After the database and the encryption key are set, `npx oe secret set <NAME>` stores any other
# secret in the encrypted credential store instead (value on stdin; nothing reads it back out).

# --- Models: the Vercel AI Gateway ---
# Local dev only. A deployed Vercel project authenticates to the gateway with OIDC and needs no key.
# Create a key at: Vercel dashboard -> AI Gateway -> API Keys.
AI_GATEWAY_API_KEY=

# --- The operational store and the credential store ---
# Postgres (Neon on Vercel). Unset locally, an embedded database under .open-everywhere-data/ is used.
DATABASE_URL=
# A base64-encoded 32-byte AES-256 key that encrypts stored credentials. This command appends a
# fresh one to .env.local without printing it:
#   node -e "console.log('OE_CREDENTIAL_ENCRYPTION_KEY=' + require('crypto').randomBytes(32).toString('base64'))" >> .env.local
# OE_CREDENTIAL_ENCRYPTION_KEY=   (append it with the command above; do not type it here)
# This deployment's public URL, e.g. https://your-app.vercel.app (credential-intake and reveal pages).
OE_PUBLIC_BASE_URL=
# Signs the credential-intake and reveal page links. Any long random string.
OE_INTAKE_PAGE_SIGNING_KEY=

# --- Slack (docs/deploy/surfaces/slack.md in the Open Everywhere repository) ---
# Slack app -> OAuth & Permissions -> Bot User OAuth Token (xoxb-…).
SLACK_BOT_TOKEN=
# Slack app -> Basic Information -> Signing Secret. Verifies every inbound event.
SLACK_SIGNING_SECRET=

# --- GitHub (docs/deploy/surfaces/github.md in the Open Everywhere repository) ---
# The GitHub App that receives webhooks and replies as the app.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_SLUG=
# Verifies inbound deliveries. If it is unset, the route refuses every delivery.
# GITHUB_WEBHOOK_SECRET=

# --- Notion (docs/deploy/surfaces/notion.md in the Open Everywhere repository) ---
# Notion shows the webhook verification token once, at subscription time. Store it here or with
# `npx oe secret set NOTION_WEBHOOK_SECRET`.
# NOTION_WEBHOOK_SECRET=
