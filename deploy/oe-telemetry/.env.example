# Neon Postgres connection string. Required for the ingest route, migrate script,
# and both cron routes.
DATABASE_URL=postgres://user:password@ep-example-000000.region.aws.neon.tech/neondb?sslmode=require

# Shared secret Vercel sends as `Authorization: Bearer $CRON_SECRET` on cron-triggered
# invocations (Vercel sets/reads this automatically once the env var exists — see
# SETUP.md). Required for /api/cron/rollup and /api/cron/prune; without it, both
# routes fail closed (401) for every caller, including Vercel's own cron.
CRON_SECRET=replace-with-a-long-random-string
