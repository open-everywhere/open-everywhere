# Discord Gateway relay — environment.
# Copy to .env for local runs (NEVER commit a filled .env); on Railway/Fly set these as service variables.

# Required — the Discord bot token (Developer Portal → Bot → Reset Token).
DISCORD_BOT_TOKEN=

# Optional — the Open Everywhere ingestion route. Unset = PROOF mode (log messages only,
# to confirm the gateway connects and Message Content Intent is on). Set = FORWARD mode.
# OE_INGEST_URL=https://<your-deploy>/eve/v1/discord-gateway

# Required in FORWARD mode — HMAC-SHA256 signing key. MUST match the value the deploy verifies.
# OE_RELAY_SECRET=

# Optional — restrict to specific guild ids (comma-separated). Empty = all guilds the bot is in.
# DISCORD_GUILD_ALLOWLIST=
