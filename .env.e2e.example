# .env.e2e.example — OPE-33 (added 2026-07-24)
#
# Template for the LIVE e2e driver pack's secrets (packages/core/scripts/e2e/{runner,scenarios,env}.ts —
# `npm run e2e:driver` from packages/core, or `npm run test:e2e-driver` from the repo root). Every
# var name below is read by env.ts's ENV registry (or by runner.ts/judge.ts directly) — this file
# is NAMES + PLACEHOLDERS only, so it is safe to commit (it's carved out of the repo's blanket
# `.env*` gitignore rule — see .gitignore's OPE-33 comment). It never contains a real secret.
#
# LOCAL sourcing: copy this file to `.env.e2e` (already gitignored) at the repo root, fill in the
# real values for your own test fixtures, then from the repo root:
#   set -a && . ./.env.e2e && set +a && cd packages/core && npm run e2e:driver
# (env must be sourced from the repo root BEFORE any `cd` — a relative `. ./.env.e2e` after a `cd`
# silently fails to find the file.)
#
# Automated sourcing: `.env.e2e` itself is NEVER committed or uploaded (it's gitignored). An
# automated run receives each var below as a named secret in its own environment; no file is ever
# written to disk. This driver pack is NOT part of the deterministic `npm test` chain, which is
# explicitly "no live model, no secrets" — see AGENTS.md's Build/test/typecheck section. The live
# pack runs on demand against a real deployment. A run without those secrets skips the affected
# scenarios and names the exact var it wanted, rather than failing.
#
# Every capability here is INDEPENDENT and OPTIONAL (env.ts's capability-shaped resolution) — set
# only the fixtures you actually have; anything unset self-skips its scenarios with the exact var
# names still missing (dry mode by default, never a hard failure).
#
# See packages/core/scripts/e2e/AUDIT.md ("Harness env families") for the coverage-matrix view of
# the same registry, and packages/core/scripts/e2e/env.ts for the authoritative per-var doc comments.

# --- SLACK (the base driver — almost every scenario rides this) ------------------------------
E2E_SLACK_USER_TOKEN=xoxp-REPLACE-ME
E2E_SLACK_CHANNEL=C0000000000
E2E_SLACK_BOT_USER_ID=U0000000000
E2E_SLACK_ADMIN_USER_ID=U0000000001

# --- SLACK add-ons (each optional; pairs with the base "slack" capability) --------------------
E2E_SLACK_PRIVATE_CHANNEL=C0000000002
E2E_SLACK_CHANNEL_B=C0000000003
E2E_SLACK_DM_CHANNEL=D0000000000
# OPE-2421: S-SLACK-AS-YOU — a channel the driver user is IN and the OE bot is NOT. The deployment must
# declare slackAsYou (agent/access/mcp-servers.ts), its Slack app needs the MCP toggle and the user
# scopes, and the driver user signs in once through the "Connect my account" card in their DM.
E2E_SLACK_UNJOINED_CHANNEL=C0000000009
# OPE-1509: J-MPIM's GROUP DM (mpim). The OE bot must be a member of the room.
# 🔴 LEAVE THIS UNSET (OPE-1640, OPE-1662). The id lives in `TRACKED_ROOM_IDS`
# (packages/core/scripts/e2e/fixture-inventory-lib.ts), so the pack resolves the room with nothing
# exported. This variable is an OVERRIDE now — set it only to aim J-MPIM at a DIFFERENT group DM. It
# used to be the room's only home, which is why J-MPIM skipped on several live runs: an environment
# nobody edited had nothing to lose the id from, and no reviewer could see it was gone.
# 🔴 THE ID CARRIES NO PROMISED PREFIX. A group DM is `G…` in an older workspace and `C…` in one on
# unified channel ids — this workspace's is a `C…`. Nothing may read the first letter to decide what
# the room is.
# To MAKE the room: `npm run e2e:fixtures -- provision-mpim` opens it over the driver user, the OE
# bot and E2E_SLACK_USER2_ID, and prints the line for that table. It needs the `mpim:write` USER
# scope on the DRIVER app, granted 2026-09-09 (before that `conversations.open` answered
# `missing_scope`).
# The DEPLOYMENT's Slack app needs `mpim:history` (to see the message) and `mpim:read` (to resolve
# the room's own sharing verdict); the DRIVER's xoxp needs `mpim:history` to read the reply back.
# No memory-domain entry: a group DM rides the workspace's own trust declaration, and no domain
# roster can name an mpim's conversation id.
E2E_SLACK_MPIM_CHANNEL=
E2E_SLACK_USER2_ID=U0000000004
E2E_SLACK_SUPERVISOR_CHANNEL=C0000000005
E2E_SLACK_UNIFIED_CHANNEL_A=C0000000006
E2E_SLACK_UNIFIED_CHANNEL_B=C0000000007
E2E_UNIFIED_DOMAIN=e2e-unified
# OPE-33: S10's dedicated throwaway-scope channel — give it its OWN tiny `perSurface` spend cap
# (config-as-code, agent/spend/budgets.ts, keyed `slack/<team id>/<this id>`) so S10's cap-tripping
# drive never entangles the shared E2E_SLACK_CHANNEL above. Absent ⇒ S10 falls back to the shared
# channel (logged, not silent). S10 reads the cap key from your budgets.ts (OPE-2205): with no
# `perSurface` row on this room, a cap that never trips reads SKIP, not RED.
E2E_SLACK_CAP_CHANNEL=C0000000008
# S-HALT's dedicated public room. The repository tracks this deployment's fixture id; leave blank
# to use that tracked room, or set an override for a fork's own isolated room.
E2E_SLACK_HALT_CHANNEL=
# OPE-33: a REAL second identity — a genuine non-admin workspace member's own xoxp token (distinct
# from E2E_SLACK_USER2_ID, which is an id only, used exclusively inside forged payloads). Both
# vars are required together. Never a real invite/create — an existing member's second app install.
E2E_SLACK_SECONDARY_TOKEN=xoxp-REPLACE-ME-SECONDARY
E2E_SLACK_SECONDARY_USER_ID=U0000000009

# --- Synthetic signed POSTs (forged approval clicks / slash commands / DM envelopes) ----------
E2E_TARGET_URL=https://your-deployment.example.com
SLACK_SIGNING_SECRET=REPLACE-ME
E2E_ORG=default

# --- Inbound webhook fixture (S20) -------------------------------------------------------------
E2E_WEBHOOK_SECRET=REPLACE-ME
E2E_WEBHOOK_HOOK_ID=e2e-smoke

# --- Discord ------------------------------------------------------------------------------------
E2E_DISCORD_DRIVER_TOKEN=REPLACE-ME
E2E_DISCORD_CHANNEL=000000000000000000
E2E_DISCORD_BOT_USER_ID=000000000000000000
# S-DISCORD-GRANT (OPE-1310). The Discord user the credential-grant ask is raised TO — a bare user
# id, or a full `discord/<id>` principal key. It must be a real person who can receive a DM from the
# OE bot, because the fixture IS a card in their 1:1. Unset ⇒ the scenario skips.
E2E_DISCORD_GRANT_OWNER=000000000000000000
# Phase 2 only — set to 1 AFTER a human taps Approve on that card. The harness can never forge the
# tap: Discord signs interactions with Ed25519 and this deployment holds only the public key.
E2E_DISCORD_GRANT_TAPPED=
# Optional thread confirmation. Phase 2 requires the exact private sidecar below; this value may
# confirm its thread but cannot replace its askId/scopeKey authority.
E2E_DISCORD_GRANT_THREAD=
# Defaults to .e2e-discord-grant-thread.json (gitignored), resolved against the driver's cwd
# (packages/core). Preserve/copy the whole private file between phase 1 and phase 2.
E2E_DISCORD_GRANT_THREAD_FILE=

# --- Teams (ST1) ---------------------------------------------------------------------------------
E2E_TEAMS_TENANT_ID=00000000-0000-0000-0000-000000000000
E2E_TEAMS_CLIENT_ID=00000000-0000-0000-0000-000000000001
E2E_TEAMS_REFRESH_TOKEN=REPLACE-ME
E2E_TEAMS_TEAM_ID=00000000-0000-0000-0000-000000000002
E2E_TEAMS_CHANNEL_ID=19:REPLACE-ME@thread.tacv2
E2E_TEAMS_BOT_APP_ID=00000000-0000-0000-0000-000000000003
# Optional — defaults to .env.e2e.teams-refresh (also gitignored) if unset.
E2E_TEAMS_REFRESH_TOKEN_FILE=.env.e2e.teams-refresh

# --- GitHub ambient surface (J-GH) ---------------------------------------------------------------
E2E_GITHUB_DRIVER_TOKEN=ghp_REPLACE-ME
E2E_GITHUB_REPO=your-org/your-scratch-repo
E2E_GITHUB_APP_SLUG=your-github-app-slug
E2E_GITHUB_ISSUE=1
# Optional — forge-path leg only.
E2E_GITHUB_WEBHOOK_SECRET=REPLACE-ME
E2E_GITHUB_INSTALLATION_ID=00000000

# --- Consequential PR write (J-PR / J-WORKFLOW) --------------------------------------------------
E2E_PR_REPO=your-org/your-granted-repo
E2E_PR_BASE=main
E2E_PR_UNGRANTED_REPO=your-org/definitely-not-granted

# --- Linear ambient surface (J-LIN) ---------------------------------------------------------------
E2E_LINEAR_API_KEY=lin_api_REPLACE-ME
E2E_LINEAR_TEAM_ID=00000000-0000-0000-0000-000000000004
E2E_LINEAR_APP_USER_ID=00000000-0000-0000-0000-000000000005
E2E_LINEAR_AGENT_HANDLE=OpenEverywhere
# Optional — forge-path leg only.
E2E_LINEAR_WEBHOOK_SECRET=REPLACE-ME

# --- A SECOND Linear workspace (the soak tests' own workspace) ------------------------------------
# Four variables register one extra workspace's OAuth application; <SLOT> is any label ([A-Z0-9]+).
# The runtime discovers them by scanning for the _ORG_ID member, so nothing else needs changing.
# See docs/deploy/surfaces/linear.md Step 2b. Set the SAME four on the deployment itself.
# LINEAR_APP_<SLOT>_ORG_ID=00000000-0000-0000-0000-00000000000f
# LINEAR_APP_<SLOT>_CLIENT_ID=REPLACE-ME
# LINEAR_APP_<SLOT>_CLIENT_SECRET=REPLACE-ME
# LINEAR_APP_<SLOT>_WEBHOOK_SECRET=REPLACE-ME

# --- Notion ambient surface (J-NOT) ---------------------------------------------------------------
E2E_NOTION_DRIVER_KEY=secret_REPLACE-ME
E2E_NOTION_PAGE_ID=00000000-0000-0000-0000-000000000006
E2E_NOTION_BOT_USER_ID=00000000-0000-0000-0000-000000000007
E2E_NOTION_WORKSPACE_ID=00000000-0000-0000-0000-000000000008
# Optional — forge-path legs only; three HUMAN-authored anchor comment ids (see env.ts's doc).
E2E_NOTION_WEBHOOK_SECRET=REPLACE-ME
E2E_NOTION_ANCHOR_ONTOPIC=00000000-0000-0000-0000-000000000009
E2E_NOTION_ANCHOR_ONTOPIC2=00000000-0000-0000-0000-00000000000a
E2E_NOTION_ANCHOR_OFFTOPIC=00000000-0000-0000-0000-00000000000b
# A fourth human-authored anchor (OPE-576). The route-taint arms replay it, because every
# driver-created comment comes back `type: "bot"` and the classifier drops it.
#
# S-TAINT-DRYRUN's Arm B DISCOVERS its own anchor (OPE-1907) — it replays the newest comment on the
# page that names the agent and asks for the page — so leaving this UNSET is the normal shape, and
# the whole fixture is "post one such comment on the page, in your own account". Set it only to pin
# one exact comment. S-TAINT-ROUTE-LIVE's Arm C still requires it and forges it unguarded.
E2E_NOTION_ANCHOR_HUMAN=00000000-0000-0000-0000-00000000000f
# S-OWN-ACCOUNT-NOTION's OWN page (OPE-1984). The repository tracks this deployment's fixture id
# (OPE-1992); leave blank to use that tracked page, or set an override for a fork's own page.
# 🔴 LEAVE IT BLANK UNLESS YOU MEAN IT. The environment WINS over the tracked id, so a placeholder
# here points the leg at a page that does not exist.
#
# It must be a SECOND page, in the same ambientSupervisor domain as E2E_NOTION_PAGE_ID and NEVER
# that page. The credential-grant legs pin E2E_NOTION_PAGE_ID as a grant's frozen argument, so once
# an owner taps that ask a standing personal road reaches it for the whole domain. An ordinary read
# of that page then goes over the borrowed grant — neither the connector tool road nor the REST road
# — so no `connector.acting_identity` row is written and the own-account gate under test never runs.
# Two live runs both scored the leg "CANNOT RUN" that way. The leg's preflight reds with that
# reason when you name E2E_NOTION_PAGE_ID here while a live standing Notion grant sits on the window.
# It covers no more than that: the audit wire carries a grant's argument NAMES and never their
# values, so a grant somebody ELSE froze on the page you name here is invisible to the harness.
E2E_NOTION_OWN_ACCOUNT_PAGE_ID=

# --- Notion connector (S24 read / S-NOTION-WRITE, S-CONNECTOR-TIER write — all optional/gated) ---
# The channel id is the whole fixture. There is NO arming env var: whether the deployment's
# personal Notion grant is consented is DERIVED from its own `connector.mint` audit rows at run
# time (scripts/e2e/connector-arming.ts, OPE-894), so an unconsented grant SKIPS the leg instead
# of scoring the agent's honest refusal as a product failure.
# 🔴 Point the QUERY at a term the fixture workspace really holds (OPE-1496). S24's HTTP rung needs
# the reply to QUOTE the page the query finds, which an honest miss cannot do; a query that matches
# nothing leaves that rung unearned. The harness reads that page with E2E_NOTION_DRIVER_KEY (the
# J-NOT driver key, no new var), so the driver integration must be connected to the fixture page —
# unset or unshared leaves the rung unearned too, and the leg prints which.
# 🔴 SEED THE PAGE, DO NOT MAKE IT BY HAND (OPE-1722). From packages/core:
#   npm run e2e:fixtures -- provision-notion-query-page
# It finds-or-creates the page under the e2e page's own parent, where the driver integration's
# connection is inherited, and writes prose the answer half can be asked to quote. A workspace
# holding no page for the term makes S24 report `fixture missing` and name this command — never a
# red, because nothing about the deployment is measured in that state.
E2E_NOTION_CHANNEL=C0000000009
E2E_NOTION_QUERY=team handbook

# --- Soak lane's OWN dedicated fixture set (OPE-845) — deliberately NOT the unified pair above ---
# Slack channel creation needs `channels:write`, a scope the driver token above does not carry
# (probed live 2026-08-19) — an operator creates #oe-soak-dev / #oe-soak-ops by hand and invites
# the OE bot + E2E_SLACK_SECONDARY_USER_ID, then sets these two.
E2E_SLACK_SOAK_CHANNEL_DEV=C0000000010
E2E_SLACK_SOAK_CHANNEL_OPS=C0000000011
# Notion pages — create with E2E_NOTION_DRIVER_KEY above (POST /v1/pages, parent = any page
# already shared with that key so the new pages inherit its connection).
E2E_NOTION_SOAK_PAGE_1=00000000-0000-0000-0000-00000000000c
E2E_NOTION_SOAK_PAGE_2=00000000-0000-0000-0000-00000000000d
# Linear label — an `issueLabelCreate` on E2E_LINEAR_TEAM_ID above, named "Soak".
E2E_SOAK_LINEAR_LABEL_ID=00000000-0000-0000-0000-00000000000e
# The soak org's OWN Linear identity. It runs a private OAuth app, so all four differ from the
# E2E_LINEAR_* set above. The driver authors as this key, and recognises the agent's replies by the
# app-user id and the handle.
E2E_LINEAR_SOAK_DRIVER_KEY=lin_api_REPLACE-ME-SOAK
E2E_SOAK_LINEAR_TEAM_ID=00000000-0000-0000-0000-000000000010
E2E_SOAK_LINEAR_APP_USER_ID=00000000-0000-0000-0000-000000000011
E2E_SOAK_LINEAR_AGENT_HANDLE=OpenEverywhere
# The soak tests' dedicated GitHub repo (OPE-855) — its own App install and its own bundle grant.
# NEVER the shared E2E_PR_REPO above; phase 4 opens a real pull request against this one.
E2E_GITHUB_SOAK_REPO=your-org/your-soak-repo
# Optional — the soak domain's NAME in agent/memory/config/domains.ts. Default "soak".
E2E_SOAK_DOMAIN=soak

# --- Runner-level knobs (all optional; unset = today's default behaviour) ------------------------
# Canonical release policy for direct-run debugging. Currently accepts "launch". Ship acceptance
# uses the rotated per-leg orchestrator; do not report this unrotated direct selector as its board.
# Do not combine it with the three ad-hoc selectors below; the tracked policy is complete.
E2E_RELEASE_SCOPE=
E2E_ONLY=
E2E_SUITE=
E2E_SURFACES=
E2E_AUDIT_SILENCES=
# Audit/usage readback (GET /control/v1/audit, cost report) — a service-token VALUE registered
# in the deployment's OE_CONTROL_READ_TOKENS, not a Slack/GitHub/etc. credential.
E2E_CONTROL_READ_TOKEN=REPLACE-ME
# Explicitly arms the local stdio control writer used by reversible live-fixture legs. It accepts
# only the pinned org + Postgres operational store and never exposes a remote write credential.
E2E_CONTROL_LOCAL_WRITE=0
OE_OPERATIONAL_PROVIDER=postgres
DATABASE_URL=postgresql://REPLACE-ME
# Wake INJECTION (POST /control/v1/test/wake) — a SEPARATE credential family whose sha256 lives in
# the deployment's OE_CONTROL_INJECT_TOKENS. It is NOT the read token above and they do not fall
# back to each other: injection makes the agent act, so it is not a read power (OPE-136). The
# window/solo/delegation/source-scoped packs and both eval harnesses need BOTH values — READ for
# the audit+transcript readback, INJECT to drive the wake. Mint with:
#   npm run mint:control-token -w @open-everywhere/core -- e2e-injector --inject
# The deployment must also set the `wake.testWakeRoute` setting (agent/settings/settings.ts), or the route 404s regardless of this token.
E2E_CONTROL_INJECT_TOKEN=REPLACE-ME
E2E_USAGE_WORKSPACES=
# Model-routing regression guard override — leave BLANK to derive the expected id set from
# agent/model/stacks.ts's SHIPPED_STACK (see env.ts's `expectModels` doc). Set only to pin a
# NON-default stack's ids explicitly.
E2E_EXPECT_MODELS=
# The POSITIVE counterpart (OPE-398) — a CSV of model ids that must EACH appear in the run's usage
# rows. E2E_EXPECT_MODELS alone passes vacuously on a run that produced no model rows at all. Set by
# `npm run e2e:stack`; off unless set.
E2E_EXPECT_MODELS_REQUIRED=
E2E_EXPECT_UNIFIED=
E2E_UNIX_ARMED=
# Optional — the spend-gate door S10 expects on E2E_SLACK_CAP_CHANNEL: mention | engagement | join |
# window. Unset ⇒ S10 only gates that the row names a KNOWN door, and logs which one.
E2E_SPEND_GATE_DOOR=
E2E_ACCESS_ALLOW_SEND=
# Set to 1 once the DM personal-access fixture is provisioned — the driver DM's PERSONAL universe
# holds something to widen or grant. J4 leg 4 then hard-fails on a missing card instead of logging a
# fixture notice, which without the pin is indistinguishable from "nothing to widen".
E2E_ACCESS_PERSONAL_FIXTURE=

# --- LLM judge (judge.ts) — REUSES the deployment's own AI Gateway credential, never a separate
# one; absent ⇒ the runner falls back to the regex judge and says so honestly in its banner. -----
AI_GATEWAY_API_KEY=REPLACE-ME
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
E2E_JUDGE_MODEL=openai/gpt-4o-mini

# --- Sibling grain/topology tools: their DEFAULT fixture ids (OPE-2195) --------------------------
# agent-delegation.ts, source-scoped-mount.ts, window-gate.ts, read-channel.ts and solo-window.ts
# are operator-run diagnostics, separate from the surface/product pack above. When a row below is
# empty, each tool falls back to a fixture id of ONE deployment. Set every row for any other
# deployment, and for a consumer that pins the product as a submodule: the product's copy of these
# defaults names rooms that do not exist in your workspaces. An empty row keeps the default.
# The pack's tracked rooms fall back the same way when their rows above are empty
# (`TRACKED_ROOM_IDS` in packages/core/scripts/e2e/fixture-inventory-lib.ts): E2E_SLACK_MPIM_CHANNEL,
# E2E_SLACK_HALT_CHANNEL, E2E_NOTION_OWN_ACCOUNT_PAGE_ID, E2E_ADDRESSED_GITHUB_REPO and
# E2E_ADDRESSED_LINEAR_TEAM_ID. window-gate.ts also reads E2E_SLACK_DM_CHANNEL (above).
# rotate-window.ts's DATABASE_URL is minted on demand (`npx neonctl connection-string …`). Never
# store it here.
# agent-delegation.ts: the domain whose seat the delegation probe wakes.
E2E_AGENT_DELEG_DOMAIN=
# agent-delegation.ts: the Slack surface key (`slack/<team>/<channel>`) of that domain.
E2E_AGENT_DELEG_SURFACE=
# source-scoped-mount.ts: the domain that holds both surfaces below.
E2E_SSM_DOMAIN=
# source-scoped-mount.ts: the Slack surface key of that domain.
E2E_SSM_SLACK_SURFACE=
# source-scoped-mount.ts: the GitHub surface key (`github/<owner>/<repo>`) of that domain.
E2E_SSM_GITHUB_SURFACE=
# source-scoped-mount.ts: the number of a standing fixture issue in that repository.
E2E_SSM_GITHUB_ISSUE=
# window-gate.ts: the domain whose window gate the tool drives.
E2E_WINDOW_GATE_DOMAIN=
# window-gate.ts: the Slack surface key of that domain.
E2E_WINDOW_GATE_SURFACE=
# read-channel.ts: the domain whose channel reads the tool drives.
E2E_GRV_DOMAIN=
# read-channel.ts: the Slack surface key of that domain.
E2E_GRV_SLACK_SURFACE=
# solo-window.ts: the SOLO domain (one window per channel).
E2E_SOLO_DOMAIN=
# solo-window.ts: the first Slack surface key of the solo domain.
E2E_SOLO_SLACK_A=
# solo-window.ts: the second Slack surface key of the solo domain, in the same workspace.
E2E_SOLO_SLACK_B=
# solo-window.ts: the cross-surface CONTROL domain. It must not be the solo domain.
E2E_SOLO_CONTROL_DOMAIN=
# solo-window.ts: the Slack surface key of the control domain.
E2E_SOLO_CONTROL_SLACK=
# solo-window.ts: the GitHub surface key of the control domain.
E2E_SOLO_CONTROL_GITHUB=
# solo-window.ts: the number of a standing fixture issue in that repository.
E2E_SOLO_CONTROL_GITHUB_ISSUE=

# --- THE ADDRESSED-ONLY DOMAIN (OPE-1503) + the fixture inventory (OPE-1504) ------------------
# One room per surface in the ADDRESSED-ONLY posture (`ambientSupervisor` off, not unified), so the
# J-ENGAGED journeys can prove "mention → plain follow-up wakes → stand_down → silence" on every
# surface. Make the rooms with, from packages/core:
#   npm run e2e:fixtures -- provision e2e-engaged
# It finds each room by name first (following every vendor's paging cursor) and creates only on a
# miss, writes the id into your local
# `.env.e2e`, and prints the `vercel env add <VAR> production` line for the deployment. Where the
# driver credential lacks the scope, it stops for that surface and prints the one-time grant.
#
# ONE NAME FAMILY, PROVISIONER AND JOURNEYS (OPE-1539). Each J-ENGAGED journey reads exactly the
# variable the plan above names for its surface — `ENGAGED_ROOM_VARS` in
# `packages/core/scripts/e2e/env.ts` — and `npm run test:fixture-inventory` joins the two, so a
# rename on one side reds the `test` chain. An unset variable costs a skip and never a false green.
# 🔴 UNSET DOES NOT MEAN DARK FOR EVERY ROOM. A room whose id is a TRACKED literal resolves from
# `TRACKED_ROOM_IDS` with nothing exported, and its variable is an OVERRIDE — J-ENGAGED-linear's
# team is such a room. What still self-skips it is its own workspace's credential and app identity,
# named on that variable's block below.
#
# SLACK HAS NO VARIABLE OF ITS OWN. The plan REUSES a room you already have: J-ENGAGED-slack drives
# E2E_SLACK_PRIVATE_CHANNEL (set further up this file). Reusing the room is NOT joining a domain —
# #oe-e2e-private must sit in NO explicit domain, which `scripts/e2e-engaged-fixture-test.ts` now
# asserts outright, and it is addressed-only there because the `org` criteria domain sets no ambient
# supervisor. Do not put that channel in ANY explicit domain: that reds the test. Its silo is
# therefore `org-brain`, the real shared brain, so J-ENGAGED-slack tears that room down like S11
# (OPE-1541): when its own memory.write rows say something reached the silo, it posts a purge ask
# scoped to the run marker it opened with. Best-effort and UNVERIFIED — nothing re-reads the store,
# so a write the model did not associate with that marker survives the run.
#
# WHICH ROOMS THE PROVISIONER CAN MAKE, measured on the live e2e credentials 2026-09-08 (OPE-1581).
# Discord, Teams, Notion and Slack it makes or reuses on its own. GitHub and Linear it CANNOT, and
# each refusal is the driver credential's own scope rather than anything about the room. BOTH rooms
# exist now and BOTH ids are TRACKED, so `provision` short-circuits on the tracked id and prints no
# one-time grant line for either. Read those two blocks below before you spend time on the dashboards.
# 🔴 THE TWO STILL DIFFER, so do not read one for the other. GITHUB's repo makes J-ENGAGED-github RUN
# wherever the base `github` capability is live — and it REDS, not skips, until the driver token can
# reach the repo. LINEAR's team resolves from the table too, and J-ENGAGED-linear self-skips only on
# that workspace's own key and app identity (E2E_ADDRESSED_LINEAR_API_KEY,
# E2E_SOAK_LINEAR_APP_USER_ID, E2E_SOAK_LINEAR_AGENT_HANDLE).
#
# GITHUB NEEDS A REPO OF ITS OWN. E2E_PR_REPO would have been the obvious reuse, but it names the
# same repository as E2E_GITHUB_REPO — `example-owner/e2e-scratch`, which `e2e-unified` holds with an
# ambient supervisor and a unified window. There the plain follow-up is answered without the
# engagement registry, so the journey would pass proving nothing.
# The provisioner creates the repo with `POST /user/repos`, PRIVATE and under the driver token's own
# account. The e2e token is FINE-GRAINED and answers 403 "Resource not accessible by personal access
# token": a fine-grained PAT creates a repo only with the ACCOUNT-level "Administration" write
# permission, which is a different setting from every repository permission it already holds. Give it
# that permission, or make the private repo by hand — the run then finds it by name.
# 🔴 THE REPO MUST BE PRIVATE. J-ENGAGED-github's non-mention arm refuses a public or
# unknown-privacy repo, so a public fixture reds step (b) for a config reason. The provisioner
# refuses a public repo of the wanted name rather than adopting it.
# 🔴 INSTALLING THE OE GITHUB APP ON THE REPO STAYS MANUAL, on a repo the provisioner made as much
# as on one you made. No PAT can install an App, and a fine-grained PAT cannot even READ the
# installation back (403 on /user/installations), so the tool prints this as a standing action and
# never claims the repo is wired.
# 🔴 LEAVE THIS UNSET (OPE-1662). `example-owner/oe-e2e-addressed-github` was created 2026-09-08 and
# its id now lives in `TRACKED_ROOM_IDS` beside the mpim's, with the repo in the `e2e-engaged` roster
# (agent/memory/config/domains/e2e-engaged.ts). The variable is an OVERRIDE — set it only to aim
# J-ENGAGED-github at a different repo.
# 🔴 THE DRIVER TOKEN MUST BE ABLE TO SEE THE REPO, and that is a SEPARATE operator action from
# making it. E2E_GITHUB_DRIVER_TOKEN is fine-grained with a selected-repository list, and a repo
# outside that list answers 404 — measured 2026-09-09, when this repo was not among its six. Add the
# repo to the token's selection, or the journey runs and reds on the first issue it opens.
E2E_ADDRESSED_GITHUB_REPO=
E2E_ADDRESSED_DISCORD_CHANNEL=
# The WHOLE Teams surface key. Shape: teams/<tenantId>/<threadId>. A bare <threadId> also works:
# both readers take the last segment, and the team comes from E2E_TEAMS_TEAM_ID either way.
# It is env-only because it is an operator's own room, not because a tenant id may not sit in a
# tracked file: a tenant id is a TRACKED literal by ruling, no gate refuses one,
# and none is wanted.
# J-ENGAGED-teams READS IT (OPE-1531). It used to drive E2E_TEAMS_CHANNEL_ID, the same room J-TEAMS
# uses, so the two scenarios shared one standing seat and one context window. Make the channel in
# the SAME team as E2E_TEAMS_CHANNEL_ID — the driver's delegated Graph auth is scoped to that team.
# Unset, J-ENGAGED-teams self-skips naming this variable; it never falls back to J-TEAMS's channel.
E2E_ADDRESSED_TEAMS_SURFACE=
# 🔴 LEAVE THIS UNSET (OPE-1666). The team is `Addressed` (key TOM) in the `second-e2e-workspace` workspace,
# opened by hand 2026-09-09, and its id lives in `TRACKED_ROOM_IDS`
# (packages/core/scripts/e2e/fixture-inventory-lib.ts), so the pack resolves the team with nothing
# exported. This variable is an OVERRIDE now — set it only to aim J-ENGAGED-linear at a DIFFERENT
# team. The room is in the `e2e-engaged` roster too
# (agent/memory/config/domains/e2e-engaged.ts), which is what gives it the addressed-only posture.
# 🔴 THE TEAM KEY `E2E` NAMES TWO TEAMS IN TWO WORKSPACES. The other is E2E_LINEAR_TEAM_ID's
# `1a000000-…`, e2e-unified's driver team, whose unified window masks this seam. Read the UUID.
# 🔴 THE PROVISIONER CANNOT MAKE THIS TEAM, which is why it was made by hand. `teamCreate` answers
# "Access denied" for the e2e key even though its `viewer.admin` reads true: a Linear personal API
# key is scoped to a SET OF TEAMS, and the e2e key holds exactly one (OPE-1581). The same
# "Access denied" also arrives when the workspace's plan has no team slot left — measured in
# `second-e2e-workspace` on 2026-09-08 (OPE-1578). The provisioner prints Linear's own reason, which the
# bare "Access denied" never names.
# 🔴 THE REMAINING OPERATOR INPUTS ARE THAT WORKSPACE'S, NOT THIS LINE. The team is in a second
# workspace, so the leg needs the key below (E2E_ADDRESSED_LINEAR_API_KEY) to REACH it and that
# workspace's app identity to recognise the agent's own reply in it — E2E_SOAK_LINEAR_APP_USER_ID
# and E2E_SOAK_LINEAR_AGENT_HANDLE, because the SOAK team is in the same workspace and a Linear app
# user is per WORKSPACE. Unset, J-ENGAGED-linear self-skips naming them, however well the table
# carries the id. Measured 2026-09-09: E2E_LINEAR_APP_USER_ID names no user of `second-e2e-workspace`.
E2E_ADDRESSED_LINEAR_TEAM_ID=
# 🔴 THE TEAM'S OWN KEY, BECAUSE THE TEAM CAN BE IN A SECOND WORKSPACE. A Linear personal API key
# never reads outside the workspace it was minted in, so where this team is NOT in E2E_LINEAR_API_KEY's
# workspace no re-mint of that one key can reach it — mint a key IN THAT WORKSPACE, scoped to the
# team, and put it here. The provisioner, the fixture inventory resolver and J-ENGAGED-linear's own
# driver all read it. UNSET means "the team is in the base workspace", the shape every other
# addressed-only room has; unset AND cross-workspace makes the provisioner SKIP this room by name,
# never red, and never invent a value. One half is not a variable at all: OE's Linear app must be
# installed in that second workspace, or the deployment never receives the follow-up comment.
E2E_ADDRESSED_LINEAR_API_KEY=
E2E_ADDRESSED_NOTION_PAGE_ID=
# Arms the `test` chain's fixture-table rung (`npm run lint:e2e-fixtures`), which compares
# docs/dev/e2e-fixtures.md against the live rooms. Unset, the rung says so and exits 0 before it
# loads anything: the chain is "no live model, no secrets" by contract, and this check calls six
# vendors. Set it to "1" only in an environment that holds the full fixture credential set. Armed,
# the rung GATES: a stale table exits 1 and fails the `test` chain (OPE-2153).
E2E_FIXTURE_TABLE_CHECK=
