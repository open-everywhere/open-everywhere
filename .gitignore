# deps
node_modules/

# secrets
.env
.env.local
.env.*.local

# eve build output / local durable state
.eve/
.output/
# The integration tier's SECOND built target (OPE-666) — the roll-own delegation regime. Build
# output like `.output/`, minted by tests/integration/global-setup.ts.
.output-rollown/
.workflow-data/

# Phase 1 durable channel-memory store (local dev). Its own git repo; never
# nest it inside the project repo's history. Override location via OE_MEMORY_DIR.
.open-everywhere-memory/

# Embedded-Postgres (PGlite) operational FLOOR data dir + its single-writer lockfile
# (OPE-113). The default local floor lives here; override location via OE_PGLITE_DIR.
# Never commit a local operational DB.
.open-everywhere-data/
.open-everywhere-data.lock
*.pglite.lock

# SQLite DB + WAL sidecars — backs BOTH the memory provider
# (OE_MEMORY_PROVIDER=sqlite) AND the operational stores (spend / routines /
# audit; sqlite is the default). The default file lives under .open-everywhere-memory/;
# this backstops a repointed OE_SQLITE_PATH so a local DB never gets committed.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Legacy file-based operational stores (pre-DB; removed). Kept ignored so any
# leftover local dirs from an old checkout never get committed.
.open-everywhere-routines/
.open-everywhere-spend/
.open-everywhere-audit/

# Private, uncommitted agent/contributor instructions (see AGENTS.md). None may reach the public
# repository: they hold machine-specific paths and detail.
CLAUDE.local*.md

# misc
*.log
.DS_Store
*.tsbuildinfo
.vercel
.env*

# Pulled Vercel env snapshots — never track. A pulled snapshot can hold a live OIDC token.
env-prod
env-*.local
.env*
!.env.example
# OPE-33: the e2e driver pack's example (var NAMES + placeholders only — see
# packages/core/scripts/e2e/AUDIT.md's "Harness env families" + docs/testing/e2e-driver.md).
# The real `.env.e2e` (gitignored by `.env*` above) never leaves the operator's shell / CI secrets.
!.env.e2e.example

# Playwright MCP session artifacts (screenshots, traces from browser-tool use)
.playwright-mcp/
# Live model-eval results (scripts/eval/ambient-eval.ts machine-readable JSON) — run-local, never tracked.
packages/core/scripts/eval/results/
# Live e2e phase-decomposition records (scripts/e2e/transcript-timings.ts) — run-local timing
# series, same posture as the eval results above: recorded, never tracked, never gated on.
packages/core/scripts/e2e/results/
# Warm-seed fill plans captured by eval runs — run-local, regenerated per run.
packages/core/scripts/eval/seeds/
# Soak-lane prefix-replay dumps (scripts/soak/soak-replay.ts) — transcript-grade prompt/response
# bytes from a soak fixture run, run-local, never tracked. Same posture as the eval results above.
packages/core/scripts/soak/results/

# PUBLISH BUILD OUTPUT (OPE-406) — `tsc -p tsconfig.build.json` per publishable package, driven by
# `npm run build:packages`. Compiled ESM + `.d.ts` (+ maps) is what a registry install actually
# executes (Node refuses to type-strip anything under node_modules), but it is derived: the `.ts`
# sources beside it are the source of truth and ship in the tarball too. Never committed.
packages/*/dist/
packages/providers/*/dist/

# The consumer-shape probe sandbox (OPE-406) — a throwaway app that installs the packed tarballs
# the way a consumer repository would. Regenerated by hand; never committed.
/.oe-consumer-probe/

# Deploy-ops known-good pointer (scripts/deploy/*, OPE-376). Per-operator state: which
# deployment last passed a health probe, plus a bounded history, so `npm run rollback` is one
# hop. Holds deployment URLs + commit shas, no secrets — but it is one person's own deploy
# record, never a shared fact about the project. Relocate with OE_DEPLOY_STATE_FILE.
.open-everywhere-deploy/

# App-state directory — per-checkout, never shared/committed. `oe upgrade` writes its resume
# marker here (`upgrade-resume.json`, packages/core/scripts/oe-upgrade.ts). The install wizard's
# consent record and telemetry guards also lived here until OPE-2233 retired them.
.open-everywhere/

# Windows WSL download metadata
*:Zone.Identifier

# Private keys / certs — NEVER commit (open-source repo)
*.pem
*.key
*.p8
*private-key*

# THE MATERIALISED EVE SLOT TREE (OPE-375) — `oe build` output, regenerated from
# `roster.config.ts` + `roster.lock.json` (both COMMITTED; they are the source of truth and the
# review surface). Never committed: a tracked copy would be a second, hand-editable roster.
#   • inspect it without committing:  `npm run oe:build -- --show`
#   • verify it matches the config:   `npm run lint:roster`
# `agent/subagents/` is deliberately NOT here — a declared subagent is authored content.
/agent/tools/
/agent/channels/
/agent/hooks/
/agent/schedules/
/agent/skills/
/agent/connections/
/agent/lib/providers.generated.ts
/agent/lib/app-code-fingerprint.generated.ts

# OPE-1821 — the runtime CODE fingerprint, hashed from this tree's runtime source by
# `prebuild:packages` (packages/core/scripts/runtime-code-fingerprint-generate.ts). Build output, never committed:
# a tracked copy would change on every code pull request and conflict with every other open pull
# request, and no reader ever needs to see it in a diff.
/packages/core/agent/channels/runtime-code-fingerprint.generated.ts
/.oe/

# A contributor's local run note: working notes, never product. A tracked copy would ship
# private working narrative to every reader, and concurrent branches would conflict on it. Stage
# it with `git add -f .oe-run-note.md` on a work branch only, and remove it before the branch lands.
/.oe-run-note.md
# S-DISCORD-GRANT's cross-run thread record (scripts/e2e/grant-thread-record.ts) — the thread id a
# raising run leaves for the tapped re-run. Run-local, one operator's own fixture state, and the
# machine-crossing carrier is the E2E_DISCORD_GRANT_THREAD pin instead. Never tracked.
# The glob covers the `.tmp` sibling the atomic write-then-rename leaves behind when a run is killed
# between the two steps — without it that orphan is untracked AND unignored, so the next `git add -A`
# commits harness scratch into the repository.
.e2e-discord-grant-thread.json*
# Pack artefacts. `npm pack` writes `<name>-<version>.tgz` into the packed workspace's own directory
# even when `--pack-destination` names somewhere else, and the publish gate packs all ten packages on
# every run (scripts/publish-lint.ts, scripts/publish-preview.ts, scripts/publish-cold-install-test.ts).
# Measured: one 8 MB `packages/core/open-everywhere-core-0.1.0.tgz` sat untracked and unignored while
# the gate ran, so a `git add -A` in that window commits it into the repository.
*.tgz
# The integration tier's PREPARED-TREE marks (OPE-2235). `tests/integration/prepare.ts` writes
# `.oe-it-prepared.json` — the cache key the artefacts on this tree were built from — and mints the
# migrated PGlite template under `.oe-it-prepare/`. Both are build output, never source: the stamp names
# one machine's tree and the template is a 41 MB PGlite data directory. The two `.tar.gz` names are the
# cache archive's staging paths; each is deleted in a `finally`, and the glob is what keeps the orphan
# from a killed run out of the next `git add -A`.
/.oe-it-prepared.json
# OPE-2280 — the root `build` gate's stamp: the cache key its `.output` was built from
# (`scripts/eve-build-stamp.ts`). Build output for one machine's tree, never source.
/.oe-it-built.json
/.oe-it-prepare/
/.oe-it-prepare-restore.tar.gz
/.oe-it-prepare-publish.tar.gz

# A built Teams app package (`surface_app_package`, OPE-2438): rebuilt from config, never committed.
teams-app/*.zip
